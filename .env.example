# Copy to .env and fill in. Never commit .env.

# LLM provider (use whichever you follow the videos with)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face (open-source embeddings / models)
HUGGINGFACEHUB_API_TOKEN=

# Web search fallback used in Corrective RAG
TAVILY_API_KEY=

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
